{
  "language": "en",
  "launcher": {
    "id": "htpc-launcher",
    "launch": null
  },
  "apps": [
    {
      "name": "YouTube",
      "id": "rocks.shy.VacuumTube",
      "icon": "~/.local/share/htpc-launcher/app-icons/youtube.png",
      "launch": ["flatpak", "run", "rocks.shy.VacuumTube", "--ozone-platform=wayland"],
      "pause_on_home": true
    },
    {
      "name": "Jellyfin",
      "id": "org.jellyfin.JellyfinDesktop",
      "icon": "~/.local/share/htpc-launcher/app-icons/jellyfin.png",
      "launch": ["flatpak", "run", "org.jellyfin.JellyfinDesktop"],
      "pause_on_home": true
    },
    {
      "name": "Moonlight",
      "id": "com.moonlight_stream.Moonlight",
      "icon": "~/.local/share/htpc-launcher/app-icons/moonlight.png",
      "launch": ["flatpak", "run", "com.moonlight_stream.Moonlight"],
      "close_on_second_press": true
    },
    {
      "name": "Steam",
      "id": "com.valvesoftware.Steam",
      "icon": "~/.local/share/htpc-launcher/app-icons/steam.png",
      "extra_ids": ["steam"],
      "launch": ["flatpak", "run", "com.valvesoftware.Steam", "-gamepadui"],
      "on_resume": ["flatpak", "run", "com.valvesoftware.Steam", "steam://open/bigpicture"],
      "close": ["flatpak", "run", "com.valvesoftware.Steam", "-shutdown"],
      "close_timeout": 10,
      "preferred_windows": ["Steam Big Picture Mode", "Steam"]
    }
  ]
}
