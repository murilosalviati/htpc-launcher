[Unit]
Description=HTPC: atalhos do controle (guide volta ao launcher, combo fecha o app)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/htpc-launcher/controle.py
# O serviço pode abrir o launcher; sem isto, reiniciar o serviço mataria o launcher junto.
KillMode=process
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
